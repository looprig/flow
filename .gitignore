# Compiled binaries / objects
*.exe
*.exe~
*.dll
*.so
*.dylib
*.o
*.a

# Test binaries
*.test

# Coverage output
*.out
coverage.*

# Profiling output
*.prof

# Editor / IDE / OS
.idea/
.vscode/
.DS_Store

# Vendored dependency tree — committed in full and built offline (-mod=vendor).
# The global ignores above (*.a, *.o, *.so, *.test, *.out, coverage.*, *.prof,
# ...) otherwise silently drop matching vendored files, yielding a tree that
# fails `go build`/`go test` from a clean checkout. This negation must stay
# LAST so it re-includes everything under vendor/.
!/vendor/**
